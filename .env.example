# Supabase
# Dapatkan dari: https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudinary
# Dapatkan dari: https://cloudinary.com → Settings → Upload → Upload Presets
# Buat preset "unsigned" dengan nama bebas
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=idmap_unsigned
