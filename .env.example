# Supabase
# Dapatkan dari: https://supabase.com → Settings → API
VITE_SUPABASE_URL=*********************
VITE_SUPABASE_ANON_KEY=*********************
VITE_SUPABASE_SERVICE_ROLE_KEY=*********************
# Cloudinary
# Dapatkan dari: https://cloudinary.com → Settings → Upload → Upload Presets
# Buat preset "unsigned" dengan nama bebas
VITE_CLOUDINARY_CLOUD_NAME=*********************
VITE_CLOUDINARY_UPLOAD_PRESET=*********************

# Convex
# Jalankan `npx convex dev` sekali, dia akan generate URL ini.
VITE_CONVEX_URL=*********************

# Clerk (auth user umum / Google sign-in)
# Dapatkan dari: https://dashboard.clerk.com → Application → API Keys → Publishable key
# Aktifkan Google sebagai SSO connection di User & Authentication → SSO Connections.
VITE_CLERK_PUBLISHABLE_KEY=*********************

# Clerk server-side setup — JANGAN gunakan prefix VITE_ untuk secret.
# Secret key: Clerk Dashboard → API Keys → Secret keys.
CLERK_SECRET_KEY=*********************
# Frontend API / issuer URL dari Clerk Convex integration atau JWT template.
# Contoh: https://xxxxx.clerk.accounts.dev atau custom Clerk domain.
CLERK_FRONTEND_API_URL=https://*********************

# Akun staff yang akan dibuat melalui script setup Clerk.
# Jangan commit password asli ke Git.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=*********************
VERIFIKATOR_USERNAME=verifikator
VERIFIKATOR_EMAIL=verifikator@example.com
VERIFIKATOR_PASSWORD=*********************

# Maintenance mode
# Kunci seluruh situs (landing page ikut terkunci, tidak ada yang bisa diklik):
#   VITE_MAINTENANCE=on
# Kunci halaman tertentu saja (biarkan VITE_MAINTENANCE=off):
#   VITE_MAINTENANCE_ROUTES=/data-pokmaswas,/verifikasi-data
# Keduanya kosong / off = maintenance mati.
VITE_MAINTENANCE=off
VITE_MAINTENANCE_ROUTES=
VITE_MAINTENANCE_MESSAGE=
VITE_MAINTENANCE_ETA=
